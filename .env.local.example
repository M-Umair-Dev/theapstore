# Copy this file to .env.local and fill in the values, then restart the server.
# .env.local is gitignored — never commit it.

# MongoDB Atlas connection string.
# Atlas → your cluster → Connect → Drivers → copy the SRV string.
# Remember to URL-encode special characters in the password (@ becomes %40).
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Database name inside that cluster.
MONGODB_DB="theapstore"

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"


# Used once by `npm run seed` to create the first admin account.
# Change the password after the first login.
SEED_ADMIN_EMAIL="admin@theapstore.com"
SEED_ADMIN_PASSWORD="change-me-before-you-deploy"
